# Production Environment Variables
# Copy this file to .env and update the values

NODE_ENV=production

# Server Configuration
PORT=3000
CORS=https://yourdomain.com,https://multiv-app-production.up.railway.app

# Database Configuration
DB_HOST=mongodb
DB_USER=app_user
DB_PASSWORD=your-secure-database-password
DB_NAME=multiv_api
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your-secure-root-password
MONGO_PORT=27017

# JWT Configuration (Generate secure secrets)
JWT_SECRET=your-super-secure-jwt-secret-minimum-32-characters
ACCESS_TOKEN_SECRET=your-super-secure-access-token-secret
REFRESH_TOKEN_SECRET=your-super-secure-refresh-token-secret

# Generate secure secrets using:
# openssl rand -base64 64

# MongoDB connection string for external databases:
# MONGODB_URI=mongodb://username:password@host:port/database